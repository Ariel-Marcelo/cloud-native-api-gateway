{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "Yarp.ReverseProxy.Health": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "MiClaveSecretaSuperSeguraDeMasDe32Caracteres2026!",
    "Issuer": "apigateway-auth",
    "Audience": "apigateway-clients"
  },
  "ResponseCaching": {
    "Enabled": true,
    "DefaultTtlSeconds": 30,
    "Routes": [
      "/api/v1/catalog/products",
      "/api/v1/orders"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "DefaultTier": "Free",
    "Tiers": {
      "Free": {
        "PermitLimit": 5,
        "WindowSeconds": 10
      },
      "Premium": {
        "PermitLimit": 10,
        "WindowSeconds": 10
      }
    }
  },
  "TransportFailureRateHealthPolicy": {
    "DetectionWindowSize": "00:00:30",
    "MinimalTotalCountThreshold": 5
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/{version}/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/{**catch-all}"
          }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/{version}/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/orders/{**catch-all}"
          }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/{version}/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/authentication/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:02" },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "catalog-service-node": {
            "Address": "http://catalog-service:8080"
          },
          "catalog-service-node-2": {
            "Address": "http://catalog-service-2:8082"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/healthz"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2",
          "TransportFailureRateHealthPolicy.FailureRateLimit": "0.3"
        }
      },
      "orders-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:02" },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "orders-service-node": {
            "Address": "http://orders-service:8083"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/healthz"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2",
          "TransportFailureRateHealthPolicy.FailureRateLimit": "0.3"
        }
      },
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "auth-service-node": {
            "Address": "http://auth-service:8085"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/healthz"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2",
          "TransportFailureRateHealthPolicy.FailureRateLimit": "0.3"
        }
      }
    }
  }
}